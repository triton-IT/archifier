{
  "openapi": "3.1.0",
  "info": {
    "title": "Petstore 3.1 sans opérations",
    "version": "1.0.0",
    "description": "API de démonstration pour l'import OpenAPI 3.1."
  },
  "servers": [
    {
      "url": "https://api.petstore.example/v1",
      "description": "Production"
    }
  ],
  "security": [
    {
      "oauth2": [
        "read:pets",
        "write:pets"
      ]
    }
  ],
  "paths": {},
  "components": {
    "schemas": {
      "Pet": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "tag": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "oauth2": {
        "type": "oauth2",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://auth.petstore.example/token",
            "scopes": {
              "read:pets": "Lire les animaux",
              "write:pets": "Modifier les animaux"
            }
          }
        }
      }
    }
  }
}
